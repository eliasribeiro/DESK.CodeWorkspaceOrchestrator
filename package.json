{
  "name": "desk.codeworkspaceorchestrator",
  "version": "1.0.0",
  "description": "Code Workspace Orchestrator - Electron + React Desktop App",
  "main": "src/main/main.cjs",
  "type": "module",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "cross-env DEV_SERVER=true vite --host 127.0.0.1",
    "dev:electron": "node scripts/dev-electron.cjs",
    "build": "vite build",
    "build:electron": "electron-builder",
    "preview": "vite preview",
    "start": "electron ."
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "tailwindcss",
    "desktop"
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.35.2",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "simple-git": "^3.32.3",
    "tailwind-merge": "^3.5.0",
    "undici": "^7.24.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.codeworkspace.orchestrator",
    "productName": "Code Workspace Orchestrator",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    }
  }
}
